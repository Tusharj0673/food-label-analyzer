# ═══════════════════════════════════════════
# LabelIQ — .gitignore
# ═══════════════════════════════════════════

# ── Python Virtual Environment ─────────────
venv/
env/
.env
.venv
ENV/

# ── Environment Variables ───────────────────
# NEVER upload these — contain API keys
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.network
frontend/.env.production
*.env

# ── Firebase Service Account ────────────────
# Contains private key — NEVER upload
backend/firebase-service-account.json
firebase-service-account.json
*service-account*.json
*serviceAccount*.json

# ── Python Cache ────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# ── Python Build ────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/

# ── Uploaded Files ──────────────────────────
# Food label images uploaded by users
backend/uploads/
uploads/

# ── AI Model Cache ──────────────────────────
# These are large — download automatically
.cache/
*.bin
*.pt
*.pth
*.ckpt
models/
model_cache/
huggingface/
transformers_cache/

# ── Node Modules ────────────────────────────
node_modules/
frontend/node_modules/

# ── React Build Output ──────────────────────
frontend/dist/
frontend/build/
dist/

# ── Vite Cache ──────────────────────────────
frontend/.vite/
.vite/

# ── IDE and Editor Files ────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
uvicorn.log

# ── OS Files ────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Testing ─────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ── Jupyter Notebooks ───────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Temporary Files ─────────────────────────
*.tmp
*.temp
*.bak
*.backup
tmp/
temp/

# ── Package Lock (optional — keep if you want) ─
# package-lock.json
# yarn.lock
